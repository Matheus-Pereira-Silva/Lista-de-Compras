rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /listas/{listaId} {

      // Só cria a própria lista: tem que ser o criador e já estar nos membros.
      allow create: if request.auth != null
        && request.resource.data.criadoPor == request.auth.uid
        && request.auth.uid in request.resource.data.membros;

      // Só membros leem a lista.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.membros;

      // Três casos permitidos de update:
      //  1) Membro mudando campos "normais" (ex: renomear a lista) — nunca
      //     'membros', nunca 'criadoPor'/'criadoEm' (imutáveis pra todo
      //     mundo), e 'codigoConvite' só se for o dono.
      //  2) Um não-membro entrando: a única mudança é 'membros' virar
      //     exatamente o array antigo + o próprio uid (redemption de convite).
      //  3) Um membro saindo: a única mudança é 'membros' perder
      //     exatamente o próprio uid, nada mais.
      // Isso impede qualquer um (até o dono) de adicionar/remover OUTRO
      // membro diretamente por update — a única porta de entrada é o
      // código de convite, e a única porta de saída é o próprio usuário.
      // Também impede um membro comum de se autodeclarar dono (criadoPor)
      // ou de gerar/revogar o convite de outra pessoa (codigoConvite).
      allow update: if request.auth != null && (
        (
          request.auth.uid in resource.data.membros
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['membros', 'criadoPor', 'criadoEm'])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['codigoConvite'])
            || request.auth.uid == resource.data.criadoPor
          )
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
          && request.resource.data.membros == resource.data.membros.concat([request.auth.uid])
        )
        || (
          request.auth.uid in resource.data.membros
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
          && request.resource.data.membros == resource.data.membros.removeAll([request.auth.uid])
        )
      );

      // Só o dono original apaga a lista.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.criadoPor;

      match /itens/{itemId} {
        // Itens seguem a membresia da lista pai.
        allow read, write: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/listas/$(listaId)).data.membros;
      }
    }

    match /convites/{codigo} {
      // Qualquer usuário autenticado pode LER um código específico (pra
      // validar ao entrar), mas nunca LISTAR a coleção inteira — isso
      // impediria alguém de "descobrir" códigos por tentativa de busca.
      allow get: if request.auth != null;
      allow list: if false;

      // Só cria convite quem já é membro da lista referenciada, e o
      // criadoPor tem que ser o próprio usuário.
      allow create: if request.auth != null
        && request.resource.data.criadoPor == request.auth.uid
        && request.auth.uid in
            get(/databases/$(database)/documents/listas/$(request.resource.data.listaId)).data.membros;

      // Convite é imutável — só existe ou é revogado (apagado).
      allow update: if false;

      // Só quem criou o convite pode revogá-lo.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.criadoPor;
    }
  }
}
